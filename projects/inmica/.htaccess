# Canonical host: redirect the bare apex domain to www (matches the canonical/OG URLs
# in index.html). HTTPS is already enforced upstream; this only fixes the host name.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^inmicavillarrobledo\.com$ [NC]
  RewriteRule ^(.*)$ https://www.inmicavillarrobledo.com/$1 [L,R=301]
</IfModule>

# Compress text-based assets.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml application/xml application/xhtml+xml application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets; HTML stays short-lived so content updates show up promptly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
</IfModule>
