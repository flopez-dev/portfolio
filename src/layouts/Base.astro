---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import { withBase } from '../lib/paths';
import { otherLang, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  /** This page in both languages, as paths under the base (e.g. 'proyectos/'). */
  paths: Record<Lang, string>;
  title: string;
  description: string;
  /** Path under the base of the sharing image. Defaults to the site-wide one. */
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const { lang, paths, title, description, ogImage = 'img/og.jpg', jsonLd } = Astro.props;

const url = (path: string) => new URL(withBase(path), Astro.site).href;
const canonical = url(paths[lang]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={url(paths.es)} />
    <link rel="alternate" hreflang="en" href={url(paths.en)} />
    <link rel="alternate" hreflang="x-default" href={url(paths.es)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Francisco López" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={url(ogImage)} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={url(ogImage)} />

    <link rel="icon" href={withBase('img/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#efede6" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body class="bg-cal pb-20 text-rotulo md:pb-0">
    <Header lang={lang} paths={paths} />

    <main id="contenido">
      <slot />
    </main>

    <Footer lang={lang} />
    <WhatsAppFlotante lang={lang} />
  </body>
</html>
