---
/**
 * A visible placeholder for content only Francisco can supply. Deliberately on
 * the page rather than in a code comment: an unfinished section that looks
 * finished is worse than one that says so. Delete the component call when the
 * real content lands.
 */
interface Props {
  children?: unknown;
}
---

<p class="mt-4 border-l-2 border-ocre pl-4 font-display text-[0.9rem] text-ocre">
  <slot />
</p>
