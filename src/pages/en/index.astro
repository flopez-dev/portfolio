---
import Base from '../../layouts/Base.astro';
import Captura from '../../components/Captura.astro';
import ProyectoCard from '../../components/ProyectoCard.astro';
import Contacto from '../../components/Contacto.astro';
import { withBase } from '../../lib/paths';
import { proyectosDe } from '../../lib/proyectos';
import { t } from '../../i18n/utils';
import { site } from '../../config';

const lang = 'en' as const;
const s = t(lang);
const paths = { es: '', en: 'en/' };

const proyectos = await proyectosDe(lang);
const destacados = proyectos.filter((p) => p.data.destacado).slice(0, 3);
const portada = proyectos.find((p) => p.slug === 'inmica') ?? proyectos[0]!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: 'Web design and development for local businesses.',
  url: new URL(withBase('en/'), Astro.site).href,
  email: `mailto:${site.email}`,
  areaServed: { '@type': 'Country', name: 'Spain' },
  serviceType: 'Web design and development for local businesses',
  provider: { '@type': 'Person', name: site.name },
};
---

<Base
  lang={lang}
  paths={paths}
  title="Francisco López — Websites for local businesses"
  description="I design and build one good page for your business: yours, no subscription, no platform. I also work as a Product Owner and Delivery Lead."
  jsonLd={jsonLd}
>
  <section class="wrap pt-10 md:pt-16">
    <div class="grid gap-8 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-7">
        <a href={withBase(`en/projects/${portada.slug}/`)} class="block border border-rotulo/15">
          <span class="block aspect-4/5 overflow-hidden bg-cal-alta md:aspect-square">
            <Captura
              nombre={portada.data.portada}
              alt={`${portada.data.cliente} website`}
              loading="eager"
              sizes="(min-width: 768px) 58vw, 100vw"
              class="h-full w-full object-cover object-top"
            />
          </span>
        </a>
        <p class="mt-3 text-[0.95rem] text-piedra">
          {portada.data.cliente} — {portada.data.sector}, Villarrobledo
        </p>
      </div>

      <div class="md:col-span-5 md:pt-6">
        <h1>Websites for businesses that already work.</h1>
        <p class="mt-6 max-w-[26em] text-[1.2rem]">
          Your business runs fine. What's missing is that the people searching for it
          online find you, and see in ten seconds what you do and how to call you.
        </p>
        <p class="mt-6">
          <a
            href={withBase(`en/projects/${portada.slug}/`)}
            class="text-azulejo underline decoration-1 underline-offset-[5px]"
          >
            How this one was built
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap mt-16 border-t border-rotulo/15 pt-10 md:mt-24">
    <p class="max-w-[30em] text-[1.35rem] leading-[1.45]">
      I build the website for a local business. One page, done properly, and yours: no
      monthly fee, no platform, and nobody to ask permission from to change a phone number.
    </p>
  </section>

  <section class="wrap mt-20 md:mt-28">
    <h2>{s('home.trabajos')}</h2>

    <ul class="mt-8 grid list-none grid-cols-1 gap-x-7 gap-y-11 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((proyecto) => <ProyectoCard proyecto={proyecto} lang={lang} />)}
    </ul>

    <p class="mt-9">
      <a href={withBase('en/projects/')} class="text-azulejo underline decoration-1 underline-offset-[5px]">
        {s('home.todos')}
      </a>
    </p>
  </section>

  <section class="wrap mt-20 border-t border-rotulo/15 pt-10 md:mt-28">
    <h2>I also deliver projects.</h2>
    <p class="mt-5 max-w-[34em] text-[1.15rem]">
      My other trade is running software projects: Product Owner and Delivery Lead.
      Prioritising, cutting what doesn't belong, and getting what was promised out on the
      date it was promised. It's why a small website lands on time too.
    </p>
    <p class="mt-6">
      <a href={withBase('en/profile/')} class="text-azulejo underline decoration-1 underline-offset-[5px]">
        My background
      </a>
    </p>
  </section>

  <Contacto lang={lang} />
</Base>
