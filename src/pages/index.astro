---
import Base from '../layouts/Base.astro';
import Captura from '../components/Captura.astro';
import ProyectoCard from '../components/ProyectoCard.astro';
import Contacto from '../components/Contacto.astro';
import { withBase } from '../lib/paths';
import { proyectosDe } from '../lib/proyectos';
import { t } from '../i18n/utils';
import { site } from '../config';

const lang = 'es' as const;
const s = t(lang);
const paths = { es: '', en: 'en/' };

const proyectos = await proyectosDe(lang);
const destacados = proyectos.filter((p) => p.data.destacado).slice(0, 3);
const portada = proyectos.find((p) => p.slug === 'inmica') ?? proyectos[0]!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: 'Diseño y desarrollo de páginas web para negocios locales.',
  url: new URL(withBase(''), Astro.site).href,
  email: `mailto:${site.email}`,
  areaServed: { '@type': 'Country', name: 'España' },
  serviceType: 'Diseño y desarrollo web para comercios locales',
  provider: { '@type': 'Person', name: site.name },
};
---

<Base
  lang={lang}
  paths={paths}
  title="Francisco López — Webs para negocios locales"
  description="Diseño y construyo la página de tu negocio: una sola, bien hecha y tuya. Sin cuotas ni plataformas. También trabajo como Product Owner y Delivery Lead."
  jsonLd={jsonLd}
>
  <section class="wrap pt-10 md:pt-16">
    <div class="grid gap-8 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-7">
        <a href={withBase(`proyectos/${portada.slug}/`)} class="block border border-rotulo/15">
          <span class="block aspect-4/5 overflow-hidden bg-cal-alta md:aspect-square">
            <Captura
              nombre={portada.data.portada}
              alt={`Página de ${portada.data.cliente}`}
              loading="eager"
              sizes="(min-width: 768px) 58vw, 100vw"
              class="h-full w-full object-cover object-top"
            />
          </span>
        </a>
        <p class="mt-3 text-[0.95rem] text-piedra">
          {portada.data.cliente} — {portada.data.sector}, Villarrobledo
        </p>
      </div>

      <div class="md:col-span-5 md:pt-6">
        <h1>Webs para negocios que ya funcionan.</h1>
        <p class="mt-6 max-w-[26em] text-[1.2rem]">
          Tu negocio ya va. Lo que falta es que quien te busca por internet te encuentre y
          sepa en diez segundos qué haces y cómo llamarte.
        </p>
        <p class="mt-6">
          <a
            href={withBase(`proyectos/${portada.slug}/`)}
            class="text-azulejo underline decoration-1 underline-offset-[5px]"
          >
            Cómo se hizo esta
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="wrap mt-16 border-t border-rotulo/15 pt-10 md:mt-24">
    <p class="max-w-[30em] text-[1.35rem] leading-[1.45]">
      Hago la página de un negocio local. Una sola, bien hecha y tuya: sin cuota mensual,
      sin plataforma y sin tener que pedirle permiso a nadie para cambiar un teléfono.
    </p>
  </section>

  <section class="wrap mt-20 md:mt-28">
    <h2>{s('home.trabajos')}</h2>

    <ul class="mt-8 grid list-none grid-cols-1 gap-x-7 gap-y-11 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((proyecto) => <ProyectoCard proyecto={proyecto} lang={lang} />)}
    </ul>

    <p class="mt-9">
      <a href={withBase('proyectos/')} class="text-azulejo underline decoration-1 underline-offset-[5px]">
        {s('home.todos')}
      </a>
    </p>
  </section>

  <section class="wrap mt-20 border-t border-rotulo/15 pt-10 md:mt-28">
    <h2>También entrego proyectos.</h2>
    <p class="mt-5 max-w-[34em] text-[1.15rem]">
      Mi otro oficio es llevar proyectos de software: Product Owner y Delivery Lead.
      Priorizar, cortar lo que sobra y hacer que lo prometido salga en la fecha que se
      dijo. Es lo que hace que una web pequeña también llegue a tiempo.
    </p>
    <p class="mt-6">
      <a href={withBase('perfil/')} class="text-azulejo underline decoration-1 underline-offset-[5px]">
        Mi trayectoria
      </a>
    </p>
  </section>

  <Contacto lang={lang} />
</Base>
